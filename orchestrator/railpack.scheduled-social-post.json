{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "build": {
      "commands": [
        "...",
        "export NODE_OPTIONS=--max-old-space-size=8192 && pnpm railway:orchestrator:build"
      ]
    }
  },
  "deploy": {
    "inputs": [
      "...",
      {
        "step": "build",
        "include": [
          "orchestrator/dist",
          "backend/dist",
          "common/dist",
          "backend/static/routes-manifest.json"
        ]
      },
      {
        "step": "packages:mise",
        "include": ["/mise/shims", "/mise/installs"]
      }
    ],
    "paths": ["/mise/shims"],
    "startCommand": "pnpm railway:orchestrator:start:scheduled-social-post"
  }
}
