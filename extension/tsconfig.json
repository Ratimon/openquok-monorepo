{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["chrome"],
    "paths": {
      "vitest": ["../web/node_modules/vitest"],
      "vitest/*": ["../web/node_modules/vitest/*"]
    }
  },
  "include": ["src/**/*.ts", "vite.config.ts"]
}
