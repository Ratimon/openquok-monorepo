{
  "manifest_version": 3,
  "name": "OpenQuok",
  "version": "0.1.0",
  "description": "Connect cookie-session social channels to OpenQuok and keep sessions refreshed.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["cookies", "alarms", "storage"],
  "host_permissions": ["*://*.skool.com/*"],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "http://localhost:*/*",
      "http://127.0.0.1:*/*",
      "https://localhost/*",
      "https://127.0.0.1/*",
      "https://localhost:*/*",
      "https://127.0.0.1:*/*",
      "https://*.openquok.com/*"
    ]
  }
}
