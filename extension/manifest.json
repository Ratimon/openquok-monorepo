{
  "manifest_version": 3,
  "name": "OpenQuok",
  "version": "0.1.0",
  "description": "Connect cookie-session social channels to OpenQuok, refresh sessions, and assist directory launches.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "OpenQuok",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["cookies", "alarms", "storage", "tabs"],
  "host_permissions": [
    "*://*.skool.com/*",
    "*://*.peerpush.com/*",
    "*://*.uneed.best/*",
    "https://*.openquok.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://uneed.best/*", "https://www.uneed.best/*"],
      "js": ["content/directory-launch/uneed-join-line.js"],
      "type": "module",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://uneed.best/*", "https://www.uneed.best/*"],
      "js": ["content/directory-launch/uneed-paid-launch.js"],
      "type": "module",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://uneed.best/*", "https://www.uneed.best/*"],
      "js": ["content/directory-launch/uneed-maker-profile.js"],
      "type": "module",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://peerpush.com/*", "https://www.peerpush.com/*"],
      "js": ["content/directory-launch/peerpush-standard-launch.js"],
      "type": "module",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://peerpush.com/*", "https://www.peerpush.com/*"],
      "js": ["content/directory-launch/peerpush-free-queue.js"],
      "type": "module",
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "http://localhost:*/*",
      "http://127.0.0.1:*/*",
      "https://localhost/*",
      "https://127.0.0.1/*",
      "https://localhost:*/*",
      "https://127.0.0.1:*/*",
      "https://*.openquok.com/*"
    ]
  }
}
