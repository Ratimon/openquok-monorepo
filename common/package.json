{
  "name": "openquok-common",
  "version": "1.0.0",
  "private": true,
  "description": "Shared types and constants for backend, web, and orchestrator",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.json",
    "test:unit": "cross-env NODE_ENV=development node ../backend/node_modules/jest/bin/jest.js --config jest.config.cjs --no-coverage"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.6.3"
  }
}
